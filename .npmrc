# The devDependencies pin the npm-published 0.1.2-alpha.3 line while the
# peerDependencies keep the family range `>=0.1.0-rc.8 <0.2.0`. npm's strict
# peer resolution auto-installs rc-line peers whose transitive ranges do not
# admit alpha prereleases, so the install fails with ERESOLVE. The devDeps
# provide every package the tests import; legacy peer resolution is the
# intended install mode for this dev line.
legacy-peer-deps=true
